# ---------- Database ----------
POSTGRES_DB=livingdocs
POSTGRES_USER=livingdocs
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# ---------- Service ports ----------
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
FRONTEND_PORT=5173

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ---------- Backend (Spring Boot) ----------
# Spring picks up SPRING_DATASOURCE_* automatically; examples below.
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/livingdocs
# SPRING_DATASOURCE_USERNAME=livingdocs
# SPRING_DATASOURCE_PASSWORD=change_me
# SERVER_PORT=8080

# ---------- Backend security (JWT) ----------
# APP_JWT_SECRET must be at least 32 bytes long for HS256.
# Generate one with: openssl rand -base64 48
APP_JWT_SECRET=change-me-please-this-is-a-development-only-secret-32b+
APP_JWT_EXPIRATION_MINUTES=1440

# ---------- Public URLs ----------
# Public URL of the BACKEND. Used for GitHub webhook deliveries and the
# generated GitHub Actions workflow — it must be reachable from the
# public internet (e.g. an ngrok tunnel) for GitHub to call it back.
APP_PUBLIC_URL=http://localhost:8080

# Public URL of the FRONTEND. Every browser-facing redirect (e.g. the
# OAuth callback landing on the SPA's /auth/callback route) uses this.
# Pointing it at the backend returns a 403, because the SPA route only
# exists in the frontend bundle.
APP_FRONTEND_URL=http://localhost:5173

# Browser origins allowed to call the API (comma-separated). Add the
# public/tunnel origin here when the app is exposed publicly.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Profile avatar storage ----------
# Directory where uploaded profile pictures are written.
# Inside Docker this path is backed by the `avatar_data` volume.
APP_AVATAR_STORAGE_DIR=./data/avatars
# Public base URL the frontend uses to fetch the image. The storage key
# ("avatars/<user-id>/<file>") is appended to it.
APP_AVATAR_PUBLIC_BASE_URL=/api/v1/users/avatar

# ---------- Backend → AI service ----------
AI_SERVICE_BASE_URL=http://ai-service:8000
AI_SERVICE_API_PREFIX=/api/v1
AI_SERVICE_ENABLED=true
AI_SERVICE_CONFIDENCE_THRESHOLD=0.65
# Shared secret presented by the backend on every call to the AI service.
# The AI service rejects unauthenticated requests when this is set, which
# keeps per-workspace API keys from being exposed to a caller who can
# reach the service directly. MUST match on both sides.
# Generate one with: openssl rand -base64 48
AI_SERVICE_INTERNAL_TOKEN=change-me-internal-service-token

# ---------- AI service (LLM + embeddings) ----------
LLM_PROVIDER=mock
# Set LLM_API_KEY before switching to a real provider.
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ---------- GitHub OAuth (Phase 2) ----------
GITHUB_OAUTH_CLIENT_ID=dev_github_client_id
GITHUB_OAUTH_CLIENT_SECRET=dev_github_client_secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/github/oauth/callback
GITHUB_OAUTH_SCOPES=repo,read:user,read:org
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_TIMEOUT_MS=15000
GITHUB_API_USER_AGENT=livingdocs-backend
GITHUB_WEBHOOK_SECRET=dev_webhook_secret
GITHUB_SANDBOX=true