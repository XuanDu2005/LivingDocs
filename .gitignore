# =====================================================
# LivingDocs — root .gitignore
# =====================================================
# This file lives at the repository root. It is honoured by git
# the moment the project is initialised with `git init` (and
# any nested .gitignore files extend it).

# ---------- Secrets / per-developer config ----------
# Real credentials MUST NOT be committed. Only the *.example templates are tracked.
.env
.env.*
!.env.example

# Tooling secrets
*.pem
*.p12
*.key
*.jks
.keystore
secrets/
credentials-manager/
secrets.json

# --------- Java / Maven ---------
target/
build/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# IDE — IntelliJ / JetBrains
.idea/
*.iml
*.iws
*.ipr
out/

# IDE — Eclipse
.classpath
.project
.settings/
.factorypath
bin/

# IDE — VS Code / Cursor
.vscode/
.cursor/
*.code-workspace

# IDE — NetBeans
nb-configuration.xml
nbproject/

# --------- Node / Frontend ---------
node_modules/
dist/
build/
.next/
.nuxt/
.cache/
.parcel-cache/
.vite/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/

# Frontend env (also covered by root .env rule, kept for clarity)
frontend/.env
frontend/.env.*
!frontend/.env.example

# --------- Python / AI service ---------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.tox/
.venv/
venv/
env/
ENV/

# AI service env
ai-service/.env
ai-service/.env.*
!ai-service/.env.example

# --------- OS noise ---------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# --------- Docker / runtime data ---------
.docker-data/
docker-data/
docker-compose.override.yml
docker-compose.local.yml
*.log
logs/

# --------- Misc ---------
*.tmp
*.bak
*.swp
*.swo
*~
.history/